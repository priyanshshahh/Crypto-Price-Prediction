# Copy to .env or .env.local and fill in (never commit real keys).
# Loaded by: crypto_pipeline/external.py (os.environ), pipeline production mode.
# .gitignore already has `.env*` with `!.env.example` exception.

# Required for macro features (dollar index, 10Y yield)
# Get free: https://fred.stlouisfed.org/docs/api/api_key.html
FRED_API_KEY=

# Optional — CoinMarketCap Basic (keyless trial-pro-api already used by default).
# https://pro.coinmarketcap.com/signup
CMC_API_KEY=

# Optional — Etherscan free key for ETH on-chain (gas / activity).
# https://etherscan.io/apis
ETHERSCAN_API_KEY=

# Optional — CoinGecko Demo key (higher rate limits). Keyless also works slower.
# https://www.coingecko.com/en/api
COINGECKO_API_KEY=

# Note: CryptoCompare / CoinDesk Data free tier was retired May 2026.
# Spot OHLCV = Coinbase + Kraken (keyless). Funding = Binance Vision (keyless).
# Polymarket crowd probs = Gamma API (keyless). ETH staking APY = DefiLlama yields (keyless).
